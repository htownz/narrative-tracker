{"generated_at": "2026-10-14T23:58:21.914538+00:00", "slug": "issue-vouchers-live", "title": "Texas school vouchers, 9 days of posts", "stats": {"posts_processed": 11, "claims": 19, "clusters": 19, "checkable": 15, "verified": 0, "unsupported_spreading": 0}, "clusters": [{"event": null, "event_type": null, "id": 1, "text": "School vouchers are becoming a political liability for Republicans in Texas and beyond.", "type": "opinion", "checkable": false, "stance": "against", "entities": ["Republicans", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 79286, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-07T13:36:39+00:00", "first_handle": "BisforBerkshire", "first_url": "https://x.com/BisforBerkshire/status/2107827446867468787", "first_views": 79286, "last_seen": "2026-10-07T13:36:39+00:00", "views_24h": 0, "series": [["2026-10-07T13:36:39+00:00", 79286]], "top_post": "https://x.com/BisforBerkshire/status/2107827446867468787"}, {"event": null, "event_type": null, "id": 2, "text": "Texas Republicans have won historic victories, including securing the border and passing school choice and Trump Accounts.", "type": "fact", "checkable": true, "stance": "for", "entities": ["Texas Republicans"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 35184, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "choice_funding_separate", "label": "Choice funded separately, not from schools", "color": "#d55181", "posts": 1}], "first_seen": "2026-10-12T22:37:33+00:00", "first_handle": "tedcruz", "first_url": "https://x.com/tedcruz/status/2109775509450113161", "first_views": 35184, "last_seen": "2026-10-12T22:37:33+00:00", "views_24h": 0, "series": [["2026-10-12T22:37:33+00:00", 35184]], "top_post": "https://x.com/tedcruz/status/2109775509450113161"}, {"event": null, "event_type": null, "id": 3, "text": "The radical left threatens Texas and America, and young Texans should make their voices heard in the midterms.", "type": "opinion", "checkable": false, "stance": "neutral", "entities": ["Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 35184, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "choice_funding_separate", "label": "Choice funded separately, not from schools", "color": "#d55181", "posts": 1}], "first_seen": "2026-10-12T22:37:33+00:00", "first_handle": "tedcruz", "first_url": "https://x.com/tedcruz/status/2109775509450113161", "first_views": 35184, "last_seen": "2026-10-12T22:37:33+00:00", "views_24h": 0, "series": [["2026-10-12T22:37:33+00:00", 35184]], "top_post": "https://x.com/tedcruz/status/2109775509450113161"}, {"event": null, "event_type": null, "id": 4, "text": "In rural Texas, the school district is generally the largest employer in a county.", "type": "fact", "checkable": true, "stance": "neutral", "entities": ["rural Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 14771, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "rural_district_financial_pain", "label": "Vouchers drain rural and public schools", "color": "#d95926", "posts": 1}], "first_seen": "2026-10-07T16:46:08+00:00", "first_handle": "MarcVeasey", "first_url": "https://x.com/MarcVeasey/status/2107875132719149407", "first_views": 14771, "last_seen": "2026-10-07T16:46:08+00:00", "views_24h": 0, "series": [["2026-10-07T16:46:08+00:00", 14771]], "top_post": "https://x.com/MarcVeasey/status/2107875132719149407"}, {"event": null, "event_type": null, "id": 5, "text": "Because of vouchers, rural Texas school district employees are starting to feel real financial pressure.", "type": "fact", "checkable": true, "stance": "against", "entities": ["rural Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 14771, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "rural_district_financial_pain", "label": "Vouchers drain rural and public schools", "color": "#d95926", "posts": 1}], "first_seen": "2026-10-07T16:46:08+00:00", "first_handle": "MarcVeasey", "first_url": "https://x.com/MarcVeasey/status/2107875132719149407", "first_views": 14771, "last_seen": "2026-10-07T16:46:08+00:00", "views_24h": 0, "series": [["2026-10-07T16:46:08+00:00", 14771]], "top_post": "https://x.com/MarcVeasey/status/2107875132719149407"}, {"event": null, "event_type": null, "id": 6, "text": "Democrats could make major gains in Texas because of school funding cuts.", "type": "prediction", "checkable": true, "stance": "against", "entities": ["Democrats", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 11341, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-13T17:14:00+00:00", "first_handle": "noosphereapp", "first_url": "https://x.com/noosphereapp/status/2110056470775496736", "first_views": 11341, "last_seen": "2026-10-13T17:14:00+00:00", "views_24h": 11341, "series": [["2026-10-13T17:14:00+00:00", 11341]], "top_post": "https://x.com/noosphereapp/status/2110056470775496736"}, {"event": null, "event_type": null, "id": 7, "text": "A Democratic win in the Texas governor's race would be a stake in the heart of the right's voucher movement.", "type": "prediction", "checkable": true, "stance": "against", "entities": ["Democrats", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 11341, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-13T17:14:00+00:00", "first_handle": "noosphereapp", "first_url": "https://x.com/noosphereapp/status/2110056470775496736", "first_views": 11341, "last_seen": "2026-10-13T17:14:00+00:00", "views_24h": 11341, "series": [["2026-10-13T17:14:00+00:00", 11341]], "top_post": "https://x.com/noosphereapp/status/2110056470775496736"}, {"event": null, "event_type": null, "id": 8, "text": "People Jessica Taylor knows in her home area of Tennessee opposed vouchers because there are no private schools nearby.", "type": "fact", "checkable": true, "stance": "against", "entities": ["Jessica Taylor", "Tennessee"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 11341, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-13T17:14:00+00:00", "first_handle": "noosphereapp", "first_url": "https://x.com/noosphereapp/status/2110056470775496736", "first_views": 11341, "last_seen": "2026-10-13T17:14:00+00:00", "views_24h": 11341, "series": [["2026-10-13T17:14:00+00:00", 11341]], "top_post": "https://x.com/noosphereapp/status/2110056470775496736"}, {"event": null, "event_type": null, "id": 9, "text": "Greg Abbott is trailing in all the competitive districts in Texas.", "type": "fact", "checkable": true, "stance": "neutral", "entities": ["Greg Abbott", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 6748, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-07T15:08:49+00:00", "first_handle": "LSPmatt", "first_url": "https://x.com/LSPmatt/status/2107850642840531443", "first_views": 6748, "last_seen": "2026-10-07T15:08:49+00:00", "views_24h": 0, "series": [["2026-10-07T15:08:49+00:00", 6748]], "top_post": "https://x.com/LSPmatt/status/2107850642840531443"}, {"event": null, "event_type": null, "id": 10, "text": "The education issue with the broadest political appeal is whether kids can read and do math, not school choice, funding or culture wars.", "type": "opinion", "checkable": false, "stance": "neutral", "entities": [], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 5771, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "accountability_outcomes_first", "label": "Focus on learning outcomes and accountability", "color": "#e66767", "posts": 1}], "first_seen": "2026-10-09T15:02:03+00:00", "first_handle": "Dale_Chu", "first_url": "https://x.com/Dale_Chu/status/2108573715651060084", "first_views": 5771, "last_seen": "2026-10-09T15:02:03+00:00", "views_24h": 0, "series": [["2026-10-09T15:02:03+00:00", 5771]], "top_post": "https://x.com/Dale_Chu/status/2108573715651060084"}, {"event": null, "event_type": null, "id": 11, "text": "85% of Texas voters are more likely to support a candidate who prioritizes grade-level proficiency.", "type": "fact", "checkable": true, "stance": "neutral", "entities": ["Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 5771, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "accountability_outcomes_first", "label": "Focus on learning outcomes and accountability", "color": "#e66767", "posts": 1}], "first_seen": "2026-10-09T15:02:03+00:00", "first_handle": "Dale_Chu", "first_url": "https://x.com/Dale_Chu/status/2108573715651060084", "first_views": 5771, "last_seen": "2026-10-09T15:02:03+00:00", "views_24h": 0, "series": [["2026-10-09T15:02:03+00:00", 5771]], "top_post": "https://x.com/Dale_Chu/status/2108573715651060084"}, {"event": null, "event_type": null, "id": 12, "text": "The Texas debate over school vouchers and public school funding has flipped suburban voters to the Democratic Party.", "type": "fact", "checkable": true, "stance": "against", "entities": ["Texas", "Democratic Party"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 5503, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-07T14:03:36+00:00", "first_handle": "BudKennedy", "first_url": "https://x.com/BudKennedy/status/2107834228385996808", "first_views": 5503, "last_seen": "2026-10-07T14:03:36+00:00", "views_24h": 0, "series": [["2026-10-07T14:03:36+00:00", 5503]], "top_post": "https://x.com/BudKennedy/status/2107834228385996808"}, {"event": null, "event_type": null, "id": 13, "text": "Dan Patrick passed school choice in Texas so families can select the school that best fits their child's needs.", "type": "fact", "checkable": true, "stance": "for", "entities": ["Dan Patrick", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 3990, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "choice_funding_separate", "label": "Choice funded separately, not from schools", "color": "#d55181", "posts": 1}], "first_seen": "2026-10-08T21:00:02+00:00", "first_handle": "DanPatrick", "first_url": "https://x.com/DanPatrick/status/2108301415492080115", "first_views": 3990, "last_seen": "2026-10-08T21:00:02+00:00", "views_24h": 0, "series": [["2026-10-08T21:00:02+00:00", 3990]], "top_post": "https://x.com/DanPatrick/status/2108301415492080115"}, {"event": null, "event_type": null, "id": 14, "text": "Greg Abbott has been heavy handed toward schools through vouchers, state takeovers, scripted curriculum, tech in schools, Ten Commandments and vendor contracts.", "type": "opinion", "checkable": true, "stance": "against", "entities": ["Greg Abbott"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 3038, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-09T16:58:45+00:00", "first_handle": "BisforBerkshire", "first_url": "https://x.com/BisforBerkshire/status/2108603081269166350", "first_views": 3038, "last_seen": "2026-10-09T16:58:45+00:00", "views_24h": 0, "series": [["2026-10-09T16:58:45+00:00", 3038]], "top_post": "https://x.com/BisforBerkshire/status/2108603081269166350"}, {"event": null, "event_type": null, "id": 15, "text": "Abbott's treatment of schools is part of why education has become a key issue in the Texas governor's race.", "type": "opinion", "checkable": true, "stance": "against", "entities": ["Greg Abbott", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 3038, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "voucher_political_liability", "label": "Vouchers are a GOP electoral liability", "color": "#3987e5", "posts": 1}], "first_seen": "2026-10-09T16:58:45+00:00", "first_handle": "BisforBerkshire", "first_url": "https://x.com/BisforBerkshire/status/2108603081269166350", "first_views": 3038, "last_seen": "2026-10-09T16:58:45+00:00", "views_24h": 0, "series": [["2026-10-09T16:58:45+00:00", 3038]], "top_post": "https://x.com/BisforBerkshire/status/2108603081269166350"}, {"event": null, "event_type": null, "id": 16, "text": "School choice funding in Texas is changing the life of a dyslexic boy by giving his family access to a suitable educational environment.", "type": "fact", "checkable": true, "stance": "for", "entities": ["Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 2596, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "tefa_success_stories", "label": "TEFA is working for families", "color": "#c98500", "posts": 1}], "first_seen": "2026-10-07T19:25:08+00:00", "first_handle": "afcpress", "first_url": "https://x.com/afcpress/status/2107915146160918704", "first_views": 2596, "last_seen": "2026-10-07T19:25:08+00:00", "views_24h": 0, "series": [["2026-10-07T19:25:08+00:00", 2596]], "top_post": "https://x.com/afcpress/status/2107915146160918704"}, {"event": null, "event_type": null, "id": 17, "text": "Greg Abbott signed the Parental Bill of Rights (SB12), school choice (SB2), and a law keeping males out of female sports, locker rooms and bathrooms.", "type": "fact", "checkable": true, "stance": "for", "entities": ["Greg Abbott"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 2222, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "choice_funding_separate", "label": "Choice funded separately, not from schools", "color": "#d55181", "posts": 1}], "first_seen": "2026-10-12T14:54:26+00:00", "first_handle": "cslape", "first_url": "https://x.com/cslape/status/2109658961074933864", "first_views": 2222, "last_seen": "2026-10-12T14:54:26+00:00", "views_24h": 0, "series": [["2026-10-12T14:54:26+00:00", 2222]], "top_post": "https://x.com/cslape/status/2109658961074933864"}, {"event": null, "event_type": null, "id": 18, "text": "Abbott's opponent voted against the Parental Bill of Rights, school choice and the sports and facilities bills.", "type": "fact", "checkable": true, "stance": "for", "entities": ["Greg Abbott"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 2222, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "choice_funding_separate", "label": "Choice funded separately, not from schools", "color": "#d55181", "posts": 1}], "first_seen": "2026-10-12T14:54:26+00:00", "first_handle": "cslape", "first_url": "https://x.com/cslape/status/2109658961074933864", "first_views": 2222, "last_seen": "2026-10-12T14:54:26+00:00", "views_24h": 0, "series": [["2026-10-12T14:54:26+00:00", 2222]], "top_post": "https://x.com/cslape/status/2109658961074933864"}, {"event": null, "event_type": null, "id": 19, "text": "Greg Abbott must be re-elected as Texas governor.", "type": "opinion", "checkable": false, "stance": "for", "entities": ["Greg Abbott", "Texas"], "verdict": null, "verdict_basis": null, "verdict_sources": [], "posts": 1, "views": 2222, "accounts": 1, "copies": 0, "pushback_posts": 0, "lanes": [{"key": "choice_funding_separate", "label": "Choice funded separately, not from schools", "color": "#d55181", "posts": 1}], "first_seen": "2026-10-12T14:54:26+00:00", "first_handle": "cslape", "first_url": "https://x.com/cslape/status/2109658961074933864", "first_views": 2222, "last_seen": "2026-10-12T14:54:26+00:00", "views_24h": 0, "series": [["2026-10-12T14:54:26+00:00", 2222]], "top_post": "https://x.com/cslape/status/2109658961074933864"}]}