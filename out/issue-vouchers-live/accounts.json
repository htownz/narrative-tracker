[{"handle": "SenMarkKelly", "name": "Senator Mark Kelly", "avatar": "https://pbs.twimg.com/profile_images/1334158015130320899/jwQnwuaZ_normal.png", "followers": 288625, "account_age_years": 5.9, "posts": 1, "views": 77483, "downstream_views": 55940, "lanes": {"rural_district_financial_pain": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["rural_district_financial_pain"], "top_post": {"id": "2110438149860311399", "views": 77483, "lane": "rural_district_financial_pain", "text": "Every kid deserves a good public education. From kindergarten to college, public schools changed my life. Every kid deserves that shot regardless of their zip code or their parents’ income. That’s why", "url": "https://x.com/SenMarkKelly/status/2110438149860311399", "t": "2026-10-14T18:30:39+00:00"}, "role": "poster", "reach": 133423, "pushback_share": 0.0}, {"handle": "BisforBerkshire", "name": "Jennifer Berkshire", "avatar": "https://pbs.twimg.com/profile_images/1721309281914327040/yCkl3g2p_normal.jpg", "followers": 19326, "account_age_years": 14.3, "posts": 2, "views": 82324, "downstream_views": 17847, "lanes": {"voucher_political_liability": 2}, "originated": 1, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["voucher_political_liability"], "top_post": {"id": "2107827446867468787", "views": 79286, "lane": "voucher_political_liability", "text": "I've been a broken record on why school vouchers are turning out to be a real liability for the GOP in Texas (and beyond). Nice to see the NYT pick up on this. https://t.co/uUGlyXO3dI", "url": "https://x.com/BisforBerkshire/status/2107827446867468787", "t": "2026-10-07T13:36:39+00:00"}, "role": "originator", "reach": 100171, "pushback_share": 0.0}, {"handle": "SenTedCruz", "name": "Senator Ted Cruz", "avatar": "https://pbs.twimg.com/profile_images/1100507943458484236/KICyvXVn_normal.jpg", "followers": 4168251, "account_age_years": 13.8, "posts": 1, "views": 55940, "downstream_views": 0, "lanes": {"pushback": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.7, "first_mover": ["pushback"], "top_post": {"id": "2110808626126532941", "views": 55940, "lane": "pushback", "text": "Mark, it’s disappointing to see you parroting the teachers unions’ misleading talking points about school choice. Let’s set the record straight.\n\nFirst, my legislation creates scholarships funded by p", "url": "https://x.com/SenTedCruz/status/2110808626126532941", "t": "2026-10-15T19:02:48+00:00"}, "role": "pushback", "reach": 55940, "pushback_share": 1.0}, {"handle": "tedcruz", "name": "Ted Cruz", "avatar": "https://pbs.twimg.com/profile_images/1798342969218510849/JaIsGsam_normal.jpg", "followers": 7071007, "account_age_years": 17.6, "posts": 1, "views": 35184, "downstream_views": 0, "lanes": {"choice_funding_separate": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["choice_funding_separate"], "top_post": {"id": "2109775509450113161", "views": 35184, "lane": "choice_funding_separate", "text": "Great to be with so many young Texans who are passionate about defending liberty and the future of our great state.\n\nWe're winning historic victories, from securing the border to passing school choice", "url": "https://x.com/tedcruz/status/2109775509450113161", "t": "2026-10-12T22:37:33+00:00"}, "role": "poster", "reach": 35184, "pushback_share": 0.0}, {"handle": "MarcVeasey", "name": "Marc Veasey", "avatar": "https://pbs.twimg.com/profile_images/1540390996697022466/z010diTX_normal.jpg", "followers": 6882, "account_age_years": 17.7, "posts": 1, "views": 14771, "downstream_views": 0, "lanes": {"rural_district_financial_pain": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.2, "first_mover": ["rural_district_financial_pain"], "top_post": {"id": "2107875132719149407", "views": 14771, "lane": "rural_district_financial_pain", "text": "In rural Texas, the school district is generally a county’s largest employer. B/c of vouchers, all of those ISD employees are starting to feel the financial pressure. And, it’s real!", "url": "https://x.com/MarcVeasey/status/2107875132719149407", "t": "2026-10-07T16:46:08+00:00"}, "role": "poster", "reach": 14771, "pushback_share": 0.0}, {"handle": "noosphereapp", "name": "Noosphere", "avatar": "https://pbs.twimg.com/profile_images/2042214931752247296/JsIMGHUr_normal.jpg", "followers": 2137, "account_age_years": 1.9, "posts": 1, "views": 11341, "downstream_views": 0, "lanes": {"voucher_political_liability": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": [], "top_post": {"id": "2110056470775496736", "views": 11341, "lane": "voucher_political_liability", "text": "Democrats could make major gains in Texas because of school funding cuts.\n\n@chucktodd: “If Texas governor goes blue, is this the stake in the heart of the voucher movement on the right?”\n\n@JessicaTayl", "url": "https://x.com/noosphereapp/status/2110056470775496736", "t": "2026-10-13T17:14:00+00:00"}, "role": "poster", "reach": 11341, "pushback_share": 0.0}, {"handle": "LSPmatt", "name": "Matt Angle", "avatar": "https://pbs.twimg.com/profile_images/2019252096483106816/gyTBBQB9_normal.jpg", "followers": 7959, "account_age_years": 13.1, "posts": 1, "views": 6748, "downstream_views": 0, "lanes": {"voucher_political_liability": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["voucher_political_liability"], "top_post": {"id": "2107850642840531443", "views": 6748, "lane": "voucher_political_liability", "text": "And the closest kept TX R secret - @GregAbbott_TX is underwater in all the competitive districts too.", "url": "https://x.com/LSPmatt/status/2107850642840531443", "t": "2026-10-07T15:08:49+00:00"}, "role": "poster", "reach": 6748, "pushback_share": 0.0}, {"handle": "afcpress", "name": "Brian Jodice", "avatar": "https://pbs.twimg.com/profile_images/1948467380822155264/Oxo9bwjq_normal.jpg", "followers": 972, "account_age_years": 1.7, "posts": 3, "views": 6141, "downstream_views": 0, "lanes": {"tefa_success_stories": 3}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["tefa_success_stories"], "top_post": {"id": "2107915146160918704", "views": 2596, "lane": "tefa_success_stories", "text": "You have to listen to this mother whose son has dyslexia and hear how school choice in Texas is changing his life.\n\n\"These funds have been a blessing to our family...\n\nFor our family, TEFA funding mea", "url": "https://x.com/afcpress/status/2107915146160918704", "t": "2026-10-07T19:25:08+00:00"}, "role": "poster", "reach": 6141, "pushback_share": 0.0}, {"handle": "Dale_Chu", "name": "Dale Chu", "avatar": "https://pbs.twimg.com/profile_images/1650708654436524034/2tbyjHTU_normal.jpg", "followers": 6926, "account_age_years": 15.8, "posts": 1, "views": 5771, "downstream_views": 0, "lanes": {"accountability_outcomes_first": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["accountability_outcomes_first"], "top_post": {"id": "2108573715651060084", "views": 5771, "lane": "accountability_outcomes_first", "text": "Turns out the education issue with the broadest political appeal isn't school choice, funding, or culture wars.\n\nIt's whether kids can read and do math.\n\n85% of Texas voters say they're more likely to", "url": "https://x.com/Dale_Chu/status/2108573715651060084", "t": "2026-10-09T15:02:03+00:00"}, "role": "poster", "reach": 5771, "pushback_share": 0.0}, {"handle": "BudKennedy", "name": "Bud Kennedy / #ReadLocal", "avatar": "https://pbs.twimg.com/profile_images/1623768897747820546/D9su2Iio_normal.jpg", "followers": 27298, "account_age_years": 18.1, "posts": 1, "views": 5503, "downstream_views": 0, "lanes": {"voucher_political_liability": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["voucher_political_liability"], "top_post": {"id": "2107834228385996808", "views": 5503, "lane": "voucher_political_liability", "text": "Not familiar with this writer, but Jessica Grose clearly explained how the Texas debate over school vouchers and publlic school funding has flipped suburban voters to the Democratic Party Includes a q", "url": "https://x.com/BudKennedy/status/2107834228385996808", "t": "2026-10-07T14:03:36+00:00"}, "role": "poster", "reach": 5503, "pushback_share": 0.0}, {"handle": "DanPatrick", "name": "Dan Patrick", "avatar": "https://pbs.twimg.com/profile_images/1453074339260141575/KrhRQy-r_normal.jpg", "followers": 177799, "account_age_years": 17.9, "posts": 1, "views": 3990, "downstream_views": 0, "lanes": {"choice_funding_separate": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["choice_funding_separate"], "top_post": {"id": "2108301415492080115", "views": 3990, "lane": "choice_funding_separate", "text": "I passed school choice for Texas families so they can select the school that best fits their child’s needs. https://t.co/RdqzQ5jBSK", "url": "https://x.com/DanPatrick/status/2108301415492080115", "t": "2026-10-08T21:00:02+00:00"}, "role": "poster", "reach": 3990, "pushback_share": 0.0}, {"handle": "cslape", "name": "Christie Slape", "avatar": "https://pbs.twimg.com/profile_images/1982775847174950913/I-coSRo__normal.jpg", "followers": 1138, "account_age_years": 16.0, "posts": 1, "views": 2222, "downstream_views": 0, "lanes": {"choice_funding_separate": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["choice_funding_separate"], "top_post": {"id": "2109658961074933864", "views": 2222, "lane": "choice_funding_separate", "text": "@GovHotWheels_TX joined us at @Moms4Liberty Summit! He has signed our Parent Pledge and stood strong for Parental Rights and education by signing into law the Parental Bill of Rights (SB12), school ch", "url": "https://x.com/cslape/status/2109658961074933864", "t": "2026-10-12T14:54:26+00:00"}, "role": "poster", "reach": 2222, "pushback_share": 0.0}, {"handle": "PMC713", "name": "Patrick", "avatar": "https://pbs.twimg.com/profile_images/1321093078577532932/y5FreuHm_normal.jpg", "followers": 4111, "account_age_years": 17.9, "posts": 1, "views": 1894, "downstream_views": 0, "lanes": {"pushback": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["pushback"], "top_post": {"id": "2108198331168223255", "views": 1894, "lane": "pushback", "text": "Steve is a superintendent for a really small school district, making $230k/year. His salary increased $45,000 in the last 4 years. \n\nMaybe he's not the most authentic representative of how most Texas ", "url": "https://x.com/PMC713/status/2108198331168223255", "t": "2026-10-08T14:10:25+00:00"}, "role": "pushback", "reach": 1894, "pushback_share": 1.0}, {"handle": "nathancunneen", "name": "Nathaniel D. Cunneen", "avatar": "https://pbs.twimg.com/profile_images/1722709752130490370/on_vQxql_normal.jpg", "followers": 2027, "account_age_years": 6.8, "posts": 1, "views": 1852, "downstream_views": 0, "lanes": {"tefa_success_stories": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["tefa_success_stories"], "top_post": {"id": "2107886012143919577", "views": 1852, "lane": "tefa_success_stories", "text": "School choice in Texas is a story of PROMISES KEPT! \n\nAll the fear-mongering and misinformation about school choice is being exposed. \n\nI’m so thankful for @DonnaCampbellTX and the Senate Ed Committee", "url": "https://x.com/nathancunneen/status/2107886012143919577", "t": "2026-10-07T17:29:22+00:00"}, "role": "poster", "reach": 1852, "pushback_share": 0.0}, {"handle": "FFRF", "name": "FFRF", "avatar": "https://pbs.twimg.com/profile_images/1233427940311891968/D_S2WuCL_normal.jpg", "followers": 87748, "account_age_years": 17.3, "posts": 1, "views": 1264, "downstream_views": 0, "lanes": {"giveaway_to_wealthy_religious": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["giveaway_to_wealthy_religious"], "top_post": {"id": "2110034832214348009", "views": 1264, "lane": "giveaway_to_wealthy_religious", "text": "Texas taxpayers are being forced to subsidize private religious schools that can discriminate against the very families footing the bill.\n\nThis isn’t “school choice.” It’s a taxpayer-funded giveaway t", "url": "https://x.com/FFRF/status/2110034832214348009", "t": "2026-10-13T15:48:01+00:00"}, "role": "poster", "reach": 1264, "pushback_share": 0.0}, {"handle": "JanJekielek", "name": "Jan Jekielek", "avatar": "https://pbs.twimg.com/profile_images/1993330158414004225/3rDZNF0L_normal.jpg", "followers": 217857, "account_age_years": 18.2, "posts": 1, "views": 1223, "downstream_views": 0, "lanes": {"choice_funding_separate": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["choice_funding_separate"], "top_post": {"id": "2110846895480533467", "views": 1223, "lane": "choice_funding_separate", "text": "For decades, Texas governors tried and failed to pass school choice.\n\nGovernor Greg Abbott finally got it done, and he told me what that moment felt like.\n\n“Governors going back to George W. Bush, to ", "url": "https://x.com/JanJekielek/status/2110846895480533467", "t": "2026-10-15T21:34:52+00:00"}, "role": "poster", "reach": 1223, "pushback_share": 0.0}, {"handle": "TPPF", "name": "Texas Public Policy Foundation", "avatar": "https://pbs.twimg.com/profile_images/1044710366075207680/FuTwD1sq_normal.jpg", "followers": 33654, "account_age_years": 17.5, "posts": 1, "views": 1210, "downstream_views": 0, "lanes": {"choice_funding_separate": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["choice_funding_separate"], "top_post": {"id": "2107582974208184472", "views": 1210, "lane": "choice_funding_separate", "text": "Let’s set the record straight.\n\nSchool choice doesn’t take a single dollar from public schools.\n\nThe Texas Education Freedom Accounts program, or TEFA, was funded completely separately through an appr", "url": "https://x.com/TPPF/status/2107582974208184472", "t": "2026-10-06T21:25:12+00:00"}, "role": "poster", "reach": 1210, "pushback_share": 0.0}, {"handle": "AshleyTXBurner", "name": "ASHLEY FRESHWATER", "avatar": "https://pbs.twimg.com/profile_images/1896390737102860288/sS8WJce4_normal.jpg", "followers": 3641, "account_age_years": 3.0, "posts": 1, "views": 1182, "downstream_views": 0, "lanes": {"voucher_political_liability": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["voucher_political_liability"], "top_post": {"id": "2108180618286686283", "views": 1182, "lane": "voucher_political_liability", "text": "I told people this would cost Republicans in Texas the election and they didn’t believe me. \n\nListen… they spent YEARS pushing the voucher shit. They had a civil war and ousted multiple Reublicans fro", "url": "https://x.com/AshleyTXBurner/status/2108180618286686283", "t": "2026-10-08T13:00:02+00:00"}, "role": "poster", "reach": 1182, "pushback_share": 0.0}, {"handle": "HargreavesBC", "name": "Andy Hargreaves", "avatar": "https://pbs.twimg.com/profile_images/997595790024495104/H2plYFgm_normal.jpg", "followers": 39782, "account_age_years": 13.9, "posts": 1, "views": 1145, "downstream_views": 0, "lanes": {"giveaway_to_wealthy_religious": 1}, "originated": 0, "bridged": 0, "copied": 0, "max_lift": 0.0, "first_mover": ["giveaway_to_wealthy_religious"], "top_post": {"id": "2107835760996946247", "views": 1145, "lane": "giveaway_to_wealthy_religious", "text": "Choosin the wrong kind of Texas. How to redistribute money from the poor to the rich through education. https://t.co/lvCwVBRRQA via @NYTOpinion @DianeRavitch @Larryferlazzo @shankerinst", "url": "https://x.com/HargreavesBC/status/2107835760996946247", "t": "2026-10-07T14:09:41+00:00"}, "role": "poster", "reach": 1145, "pushback_share": 0.0}]